{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vasilis-vasiliadis-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "vars": {
    "MAIN_HOST": "vasilisvasiliadis.gr",
    "MAILERLITE_GROUP_ID": "204833612720244014"
  },
  "observability": { "enabled": true }
  // Μυστικό (δεν μπαίνει εδώ): MAILERLITE_API_KEY
  // Ορίζεται στο Cloudflare: Worker → Settings → Variables and Secrets
}
